# --- 1. 排除编译产出目录 (体积最大) ---
windows_build*/
linux_build*/
linux_cross_build*/
android_build*/

# --- 2. 排除二进制可执行文件 ---
*.exe
*.dll
*.so
*.dylib
*.app
fftools/ffmpeg
fftools/ffplay
fftools/ffprobe

# --- 3. 排除编译中间文件 ---
*.o
*.a
*.lib
*.la
*.lo
*.d
*.pc
*.def
*.exp
common.mak

# --- 4. 排除自动生成的配置文件 (环境相关) ---
config.h
config.mak
config.log
ffbuild/config.mak
ffbuild/config.log
libavutil/avconfig.h
libavutil/ffversion.h

# --- 5. 排除 AVS3 调试残留 ---
*.tmp
log_dec.txt
probestat.tmp

# --- 6. 排除 IDE 配置 (可选) ---
.idea/
.vscode/
*.swp
*.swo

# --- 7. 特殊排除：保留构建脚本，但排除其产生的缓存 ---
build_scripts/ffmpeg-windows-build-helpers/
